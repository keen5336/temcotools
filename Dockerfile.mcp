FROM node:24-alpine

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

COPY prisma ./prisma
COPY lib ./lib
COPY scripts ./scripts
# The retained label defaults/parser are shared by UI and application commands.
COPY app/tools/rtv-label/marsLabelShared.ts ./app/tools/rtv-label/marsLabelShared.ts
COPY prisma.config.ts tsconfig.json ./

RUN npx prisma generate

RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 --ingroup nodejs nextjs
USER nextjs:nodejs

# Revision metadata must not invalidate the locked dependency-install layer.
ARG VCS_REF=unknown
LABEL org.opencontainers.image.revision=$VCS_REF

CMD ["npm", "run", "--silent", "mcp"]
