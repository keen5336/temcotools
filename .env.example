# Private local PostgreSQL target. Never use a production URL for tests.
DATABASE_URL=
# Compose requires the actual private database password; no built-in default.
POSTGRES_PASSWORD=
# At least 32 characters, privately generated/delivered; never commit actual values.
SESSION_SECRET=
# Production requires 32 random bytes encoded as base64url; preserve independently
# across cookie-key rotation and with protected database backups.
MFA_ENCRYPTION_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
WAREHOUSE_TIME_ZONE=America/Chicago
# Remote MCP is optional. Loopback port differences are allowed only locally.
MCP_ISSUER_URL=http://localhost:3004/
MCP_RESOURCE_URL=http://localhost:3004/mcp
# Short-lived stdio client grant issued by an actual signed-in individual.
TEMCO_MCP_TOKEN=
# No default account/PIN. See docs/v2/cutover-runbook.md for private enrollment.
