DATABASE_URL=postgresql://ops_tools:password@localhost:5432/ops_tools

# Secret used to encrypt session cookies — generate with: openssl rand -base64 32
# Must be at least 32 characters long.
SESSION_SECRET=change-me-use-openssl-rand-base64-32

# First administrator identity; no initial PIN/password is created.
# See docs/account-migration.md for guarded offline setup commands.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator

# Canonical public origin for same-origin account actions.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Enable only behind the trusted deployment reverse proxy.
TRUST_PROXY=false

# MCP uses the same canonical origin by default. Only administrators can approve.
# Set a different origin only when the application is genuinely hosted there.
# MCP_ISSUER_URL=https://temco.chronchive.com
# Optional exact browser/extension origins for browser-based MCP clients.
MCP_ALLOWED_ORIGINS=
# Fixed internal label relay used for MCP printing; never supplied by a tool caller.
LABEL_RELAY_INTERNAL_URL=http://127.0.0.1:3002
