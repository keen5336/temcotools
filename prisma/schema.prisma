generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String             @id @default(cuid())
  username              String             @unique
  displayName           String
  pinHash               String
  passwordHash          String?
  passwordChangedAt     DateTime?
  role                  Role               @default(user)
  isActive              Boolean            @default(true)
  authVersion           Int                @default(1)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  lastLoginAt           DateTime?
  favoriteToolIds       String[]           @default([])
  accessGrants          AppAccessGrant[]
  authSessions          UserSession[]
  recoveryTokens        IdentityRecoveryToken[]
  roleBundles           UserRoleBundle[]
  mfa                   UserMfa?
  marsImportBatches     MarsImportBatch[]
  marsEvents            MarsEvent[]
  marsAuditSessions     MarsAuditSession[]
  marsAuditScans        MarsAuditScan[]
  marsAuditReports      MarsAuditReport[]
  scanListSessions      ScanListSession[]
  scanListItems         ScanListItem[]
  pickWaves             PickWave[]
  pickWaveScans         PickWaveScan[]
  routeRecons           RouteRecon[]
  labelPrintersCreated  LabelPrinter[]     @relation("LabelPrinterCreatedBy")
  labelPrintersUpdated  LabelPrinter[]     @relation("LabelPrinterUpdatedBy")
  labelTemplatesCreated LabelTemplate[]    @relation("LabelTemplateCreatedBy")
  labelTemplatesUpdated LabelTemplate[]    @relation("LabelTemplateUpdatedBy")
}

model UserSession {
  id                      String    @id
  userId                  String
  authVersion             Int
  createdAt               DateTime  @default(now())
  lastActivityAt          DateTime  @default(now())
  lastStrongAuthenticatedAt DateTime @default(now())
  mfaVerifiedAt           DateTime?
  expiresAt               DateTime
  revokedAt               DateTime?
  lockedAt                DateTime?
  deviceLabel             String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model UserMfa {
  userId              String            @id
  encryptedSecret     String
  enrollmentSessionId String
  pendingExpiresAt    DateTime?
  enabledAt           DateTime?
  lastUsedStep        Int               @default(-1)
  createdAt           DateTime          @default(now())
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes       MfaRecoveryCode[]
}

model MfaRecoveryCode {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  mfa        UserMfa   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, codeHash])
}

model IdentityRecoveryToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  authVersion Int
  purpose     String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?
  issuedById  String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model IdentityAudit {
  id           String   @id @default(cuid())
  action       String
  actorUserId  String?
  targetUserId String?
  sessionId    String?
  sourceHash   String?
  reason       String?
  createdAt    DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([actorUserId, createdAt])
}

model AuthRateLimit {
  key         String   @id
  windowStart DateTime
  attempts    Int      @default(1)
}

model RoleBundle {
  id           String           @id @default(cuid())
  name         String           @unique
  description  String           @default("")
  capabilities String[]
  isSystem     Boolean          @default(false)
  updatedAt    DateTime         @updatedAt
  assignments  UserRoleBundle[]
}

model UserRoleBundle {
  userId   String
  bundleId String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bundle   RoleBundle @relation(fields: [bundleId], references: [id], onDelete: Restrict)

  @@id([userId, bundleId])
}

model AppAccessGrant {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  userId      String
  sessionId   String?
  authVersion Int
  clientName  String
  audience    String   @default("temcotools-mcp")
  scopes      String[]
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model LabelPrinter {
  id              String   @id @default(cuid())
  name            String   @unique
  endpoint        String
  contentType     String   @default("text/plain")
  isActive        Boolean  @default(true)
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUser   User?    @relation("LabelPrinterCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser   User?    @relation("LabelPrinterUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([isActive, name])
}

model LabelTemplate {
  id              String            @id @default(cuid())
  name            String
  kind            LabelTemplateKind
  zpl             String
  isActive        Boolean           @default(true)
  isDefault       Boolean           @default(false)
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  createdByUser   User?             @relation("LabelTemplateCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser   User?             @relation("LabelTemplateUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([kind, name])
  @@index([kind, isActive, name])
}


model MarsImportBatch {
  id               String            @id @default(cuid())
  filename         String
  uploadedByUserId String?
  uploadedAt       DateTime          @default(now())
  rowCount         Int               @default(0)
  insertedCount    Int               @default(0)
  updatedCount     Int               @default(0)
  skippedCount     Int               @default(0)
  notes            String?
  uploadedByUser   User?             @relation(fields: [uploadedByUserId], references: [id])
  marsUnits        MarsUnit[]
  marsAuditReports MarsAuditReport[]
}

model MarsUnit {
  id                        String           @id @default(cuid())
  requestNumber             String           @unique
  orderNumber               String?
  vendor                    String?
  serialNumber              String?
  modelNumber               String?
  vendorRaNumber            String?
  dateRequested             DateTime?
  requestStatus             String?
  returnStatus              String?
  replacementNeeded         String?
  staged                    Boolean          @default(false)
  localStatus               String           @default("active")
  archivedAt                DateTime?
  archivedReason            String?
  presentInLatestImport     Boolean          @default(true)
  missingFromLatestImportAt DateTime?
  lastImportedAt            DateTime?
  lastScannedAt             DateTime?
  lastAuditSeenAt           DateTime?
  lastKnownImportBatchId    String?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  lastKnownImportBatch      MarsImportBatch? @relation(fields: [lastKnownImportBatchId], references: [id])
  marsEvents                MarsEvent[]
  marsAuditScans            MarsAuditScan[]
}

model MarsEvent {
  id         String   @id @default(cuid())
  marsUnitId String
  type       String
  payload    Json
  userId     String?
  createdAt  DateTime @default(now())
  marsUnit   MarsUnit @relation(fields: [marsUnitId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])
}

model MarsAuditSession {
  id               String            @id @default(cuid())
  startedByUserId  String?
  startedAt        DateTime          @default(now())
  completedAt      DateTime?
  lastAmendedAt    DateTime?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  startedByUser    User?             @relation(fields: [startedByUserId], references: [id])
  marsAuditScans   MarsAuditScan[]
  marsAuditReports MarsAuditReport[]
}

model MarsAuditScan {
  id                 String           @id @default(cuid())
  auditSessionId     String
  scannedValue       String
  marsUnitId         String?
  matched            Boolean          @default(false)
  duplicateInSession Boolean          @default(false)
  manualEntry        Boolean          @default(false)
  userId             String?
  createdAt          DateTime         @default(now())
  auditSession       MarsAuditSession @relation(fields: [auditSessionId], references: [id], onDelete: Cascade)
  marsUnit           MarsUnit?        @relation(fields: [marsUnitId], references: [id])
  user               User?            @relation(fields: [userId], references: [id])
}

model MarsAuditReport {
  id                String           @id @default(cuid())
  auditSessionId    String
  importBatchId     String?
  generatedByUserId String?
  label             String?
  createdAt         DateTime         @default(now())
  summary           Json
  payload           Json
  auditSession      MarsAuditSession @relation(fields: [auditSessionId], references: [id], onDelete: Cascade)
  importBatch       MarsImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  generatedByUser   User?            @relation(fields: [generatedByUserId], references: [id])
}

model ScanListSession {
  id              String         @id @default(cuid())
  localDraftId    String?        @unique
  name            String
  createdByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  closedAt        DateTime?
  archivedAt      DateTime?
  createdByUser   User?          @relation(fields: [createdByUserId], references: [id])
  items           ScanListItem[]

  @@index([archivedAt, updatedAt])
}

model ScanListItem {
  id              String          @id @default(cuid())
  sessionId       String
  scannedValue    String
  scannedByUserId String?
  createdAt       DateTime        @default(now())
  session         ScanListSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  scannedByUser   User?           @relation(fields: [scannedByUserId], references: [id])

  @@index([sessionId, createdAt])
}

model PickWave {
  id              String                 @id @default(cuid())
  name            String
  sourceFilename  String
  createdByUserId String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  archivedAt      DateTime?
  createdByUser   User?                  @relation(fields: [createdByUserId], references: [id])
  items           PickWaveItem[]
  routeMappings   PickWaveRouteMapping[]
  scans           PickWaveScan[]

  @@index([archivedAt, createdAt])
}

model PickWaveItem {
  id             String         @id @default(cuid())
  pickWaveId     String
  rowNumber      Int
  routeNumber    String?
  contact        String?
  orderNumber    String?
  lpn            String?
  serialNumber   String?
  trackingNumber String?
  partNumber     String?
  description    String?
  scannedAt      DateTime?
  createdAt      DateTime       @default(now())
  pickWave       PickWave       @relation(fields: [pickWaveId], references: [id], onDelete: Cascade)
  scans          PickWaveScan[]

  @@unique([pickWaveId, rowNumber])
  @@index([pickWaveId, scannedAt])
  @@index([pickWaveId, lpn])
  @@index([pickWaveId, serialNumber])
  @@index([pickWaveId, trackingNumber])
  @@index([pickWaveId, orderNumber])
}

model PickWaveRouteMapping {
  id              String   @id @default(cuid())
  pickWaveId      String
  routeNumber     String
  stagingLocation String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  pickWave        PickWave @relation(fields: [pickWaveId], references: [id], onDelete: Cascade)

  @@unique([pickWaveId, routeNumber])
  @@index([pickWaveId])
}

model PickWaveScan {
  id              String        @id @default(cuid())
  pickWaveId      String
  itemId          String?
  scannedValue    String
  captureEventId  String?       @unique
  captureResult   Json?
  matched         Boolean       @default(false)
  alreadyScanned  Boolean       @default(false)
  scannedByUserId String?
  createdAt       DateTime      @default(now())
  pickWave        PickWave      @relation(fields: [pickWaveId], references: [id], onDelete: Cascade)
  item            PickWaveItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  scannedByUser   User?         @relation(fields: [scannedByUserId], references: [id])

  @@index([pickWaveId, createdAt])
  @@index([itemId])
}

model RouteRecon {
  id              String           @id @default(cuid())
  name            String
  sourceFilename  String
  routeCount      Int
  createdByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  archivedAt      DateTime?
  createdByUser   User?            @relation(fields: [createdByUserId], references: [id])
  items           RouteReconItem[]

  @@index([archivedAt, createdAt])
}

model RouteReconItem {
  id             String     @id @default(cuid())
  routeReconId   String
  rowNumber      Int
  routeNumber    String?
  contact        String?
  orderNumber    String?
  lpn            String?
  serialNumber   String?
  trackingNumber String?
  partNumber     String?
  description    String?
  createdAt      DateTime   @default(now())
  routeRecon     RouteRecon @relation(fields: [routeReconId], references: [id], onDelete: Cascade)

  @@unique([routeReconId, rowNumber])
  @@index([routeReconId, routeNumber])
}

enum Role {
  admin
  manager
  user
}

enum LabelTemplateKind {
  mars_return
  pick_wave
}


// LPN source records and scan evidence are retained independently of pick-wave deletion.
model InventoryAuditItem {
  id               String   @id @default(cuid())
  lpn              String   @unique
  status           String
  orderNumber      String
  vendor           String
  receivedDate     String
  description      String
  customerName     String
  sourceData       Json
  contentHash      String
  revision         Int      @default(1)
  firstSeenAt      DateTime @default(now())
  sourceChangedAt  DateTime @default(now())
  verifiedAt       DateTime?
  lastScannedAt    DateTime?
  lastScanWaveName  String?
  archivedAt       DateTime?
  unitId           String?
  unit             WarehouseUnit? @relation(fields: [unitId], references: [id], onDelete: Restrict)
  sourceRevisions  InventorySourceRevision[]

  @@index([archivedAt, sourceChangedAt, lpn])
  @@index([verifiedAt])
}

model InventoryAuditImport {
  id             String   @id @default(cuid())
  filename       String
  uploadedByName String
  createdAt      DateTime @default(now())
  rowCount       Int
  insertedCount  Int
  changedCount   Int
  unchangedCount Int
  duplicateCount Int
  blankCount     Int
  scope          String   @default("warehouse")
  coverage       String   @default("partial")
  sourceAsOf     DateTime?
  uploadedByUserId String?
  memberships    InventoryImportMembership[]

  @@index([createdAt])
}

model InventoryAuditScan {
  id              String   @id @default(cuid())
  sourceScanId    String   @unique
  pickWaveId      String
  pickWaveName    String
  scannedValue    String
  lpn             String?
  scannedByName   String?
  matchedPickWave Boolean
  duplicateInWave Boolean
  scannedAt       DateTime
  exportedAt      DateTime @default(now())

  @@index([lpn, scannedAt])
  @@index([pickWaveId])
}

// Centrally managed source for known external-page integrations. Draft source
// stays private; only immutable, deliberately published versions are served.
model Payload {
  id                 String           @id
  name               String
  purpose            String
  targetOrigins      String[]
  draftSource        String
  protocolVersion    Int              @default(1)
  operationNames     String[]         @default([])
  revision           Int              @default(1)
  enabled            Boolean          @default(true)
  publishedVersionId String?          @unique
  createdByUserId    String
  updatedByUserId    String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  versions           PayloadVersion[] @relation("PayloadVersions")
  publishedVersion   PayloadVersion?  @relation("PayloadPublished", fields: [publishedVersionId], references: [id], onDelete: Restrict)
  audits             PayloadAudit[]
}

model PayloadVersion {
  id              String    @id @default(cuid())
  payloadId       String
  version         Int
  purpose         String
  targetOrigins   String[]
  source          String
  protocolVersion Int
  operationNames  String[]
  contentHash     String
  publishedByUserId String
  publishedAt     DateTime  @default(now())
  note            String
  payload         Payload   @relation("PayloadVersions", fields: [payloadId], references: [id], onDelete: Restrict)
  currentFor      Payload?  @relation("PayloadPublished")

  @@unique([payloadId, version])
  @@index([payloadId, publishedAt])
}

model PayloadAudit {
  id          String   @id @default(cuid())
  payloadId   String
  actorUserId String
  action      String
  revision    Int
  versionId   String?
  note        String
  createdAt   DateTime @default(now())
  payload     Payload  @relation(fields: [payloadId], references: [id], onDelete: Restrict)

  @@index([payloadId, createdAt])
}

model LabelWorkflow {
  purpose            String @id
  name               String
  draftZpl           String
  requiredFields     String[]
  rules              Json
  widthMm            Float
  heightMm           Float
  dpi                Int
  revision           Int @default(1)
  enabled            Boolean @default(true)
  publishedVersionId String? @unique
  updatedByUserId    String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  versions           LabelWorkflowVersion[] @relation("LabelWorkflowVersions")
  publishedVersion   LabelWorkflowVersion? @relation("LabelWorkflowPublished", fields: [publishedVersionId], references: [id], onDelete: Restrict)
  audits             LabelWorkflowAudit[]
}

model LabelWorkflowVersion {
  id                 String @id @default(cuid())
  purpose            String
  version            Int
  name               String
  zpl                String
  requiredFields     String[]
  rules              Json
  widthMm            Float
  heightMm           Float
  dpi                Int
  contentHash        String
  publishedByUserId  String
  note               String
  publishedAt        DateTime @default(now())
  workflow           LabelWorkflow @relation("LabelWorkflowVersions", fields: [purpose], references: [purpose], onDelete: Restrict)
  currentFor         LabelWorkflow? @relation("LabelWorkflowPublished")

  @@unique([purpose, version])
}

model LabelWorkflowAudit {
  id          String @id @default(cuid())
  purpose     String
  actorUserId String
  action      String
  revision    Int
  versionId   String?
  note        String
  createdAt   DateTime @default(now())
  workflow    LabelWorkflow @relation(fields: [purpose], references: [purpose], onDelete: Restrict)

  @@index([purpose, createdAt])
}

model PrintingDevice {
  id            String @id
  userId        String
  sessionId     String
  authVersion   Int
  tokenHash     String
  name          String
  mode          String
  printerIds    String[]
  lastSeenAt    DateTime @default(now())
  leaseExpiresAt DateTime
  revokedAt     DateTime?
  createdAt     DateTime @default(now())

  @@index([mode, leaseExpiresAt])
  @@index([userId, sessionId])
}

model LabelIssuance {
  id                   String @id @default(cuid())
  operationId          String
  actorUserId          String
  actorSessionId       String
  actorAuthVersion     Int
  actorGrantId         String?
  actorAuthSource      String
  actorCapabilities    String[]
  unitId               String?
  purpose              String
  printerId            String
  workflowVersionId    String?
  contentFingerprint   String
  inputFingerprint     String
  renderedZpl          String
  mode                 String
  deviceId             String
  state                String @default("queued")
  automatic            Boolean @default(false)
  reprintOf            String?
  reason               String?
  ruleId               String?
  claimTokenHash       String?
  reportFingerprint    String?
  dispatchedAt         DateTime?
  reportedAt           DateTime?
  physicallyConfirmedAt DateTime?
  appliedAt            DateTime?
  reconciledAt         DateTime?
  reconciliationNote   String?
  createdAt            DateTime @default(now())
  events               LabelIssuanceEvent[]

  @@unique([actorUserId, operationId])
  @@index([unitId, purpose, createdAt])
  @@index([deviceId, state, createdAt])
  @@index([contentFingerprint, printerId])
}

model LabelIssuanceEvent {
  id          String @id @default(cuid())
  issuanceId  String
  actorUserId String
  deviceId    String?
  action      String
  state       String
  note        String
  createdAt   DateTime @default(now())
  issuance    LabelIssuance @relation(fields: [issuanceId], references: [id], onDelete: Restrict)

  @@index([issuanceId, createdAt])
}

// Physical identity is independent of order context, source rows and submissions.
model WarehouseUnit {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  createdByUserId  String?
  creationEvidence String?
  creationFingerprint String?
  inventoryRows   InventoryAuditItem[]
  identifiers     WarehouseIdentifier[]
  observations    WarehousePhysicalObservation[]
  observationCorrections WarehouseObservationCorrection[]
}

model WarehouseIdentifier {
  id                  String   @id @default(cuid())
  unitId              String
  unit                WarehouseUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  kind                String
  namespace           String
  value               String
  rawValue            String
  evidence            String
  createdByUserId     String?
  createdAt           DateTime @default(now())
  revokedAt           DateTime?
  revokedByUserId      String?
  revocationReason    String?

  @@index([kind, namespace, value, revokedAt])
  @@index([unitId, createdAt])
}

model InventorySourceRevision {
  id                String   @id @default(cuid())
  inventoryItemId   String
  inventoryItem     InventoryAuditItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  revision          Int
  contentHash       String
  sourceData        Json
  lpn               String
  status            String
  receivedDate      String
  orderNumber       String
  vendor            String
  description       String
  customerName      String
  recordedAt        DateTime @default(now())
  migrationSnapshot Boolean @default(false)
  memberships       InventoryImportMembership[]

  @@unique([inventoryItemId, revision])
}

model InventoryImportMembership {
  id               String   @id @default(cuid())
  importId         String
  importBatch      InventoryAuditImport @relation(fields: [importId], references: [id], onDelete: Restrict)
  sourceRevisionId String
  sourceRevision   InventorySourceRevision @relation(fields: [sourceRevisionId], references: [id], onDelete: Restrict)
  lpn              String

  @@unique([importId, lpn])
  @@index([lpn, importId])
}

model WarehousePhysicalObservation {
  id                    String   @id @default(cuid())
  userId                String
  eventId               String
  fingerprint           String
  rawIdentifier         String
  identifierType        String
  identifierNamespace   String?
  type                  String
  location              String?
  deviceId              String?
  pickWaveId            String?
  captureMethod         String
  capturedAt            DateTime
  receivedAt            DateTime @default(now())
  unitId                String?
  unit                  WarehouseUnit? @relation(fields: [unitId], references: [id], onDelete: Restrict)
  resolution            String
  candidateUnitIds      Json
  corrections           WarehouseObservationCorrection[]

  @@unique([userId, eventId])
  @@index([unitId, capturedAt])
  @@index([resolution, receivedAt])
}

model WarehouseObservationCorrection {
  id               String   @id @default(cuid())
  observationId    String
  observation      WarehousePhysicalObservation @relation(fields: [observationId], references: [id], onDelete: Restrict)
  unitId           String?
  unit             WarehouseUnit? @relation(fields: [unitId], references: [id], onDelete: Restrict)
  reason           String
  userId           String
  createdAt        DateTime @default(now())
  revision         Int

  @@index([observationId, createdAt])
  @@unique([observationId, revision])
}









