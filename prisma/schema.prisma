generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String             @id @default(cuid())
  username              String             @unique
  displayName           String
  pinHash               String
  passwordHash          String?
  passwordEnrolledAt    DateTime?
  passwordChangedAt     DateTime?
  legacyDisabledAt      DateTime?
  authVersion           Int                @default(1)
  role                  Role               @default(user)
  isActive              Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  lastLoginAt           DateTime?
  favoriteToolIds       String[]           @default([])
  marsImportBatches     MarsImportBatch[]
  marsEvents            MarsEvent[]
  marsAuditSessions     MarsAuditSession[]
  marsAuditScans        MarsAuditScan[]
  marsAuditReports      MarsAuditReport[]
  scanListSessions      ScanListSession[]
  scanListItems         ScanListItem[]
  pickWaves             PickWave[]
  pickWaveScans         PickWaveScan[]
  routeRecons           RouteRecon[]
  labelPrintersCreated  LabelPrinter[]     @relation("LabelPrinterCreatedBy")
  labelPrintersUpdated  LabelPrinter[]     @relation("LabelPrinterUpdatedBy")
  labelTemplatesCreated LabelTemplate[]    @relation("LabelTemplateCreatedBy")
  labelTemplatesUpdated LabelTemplate[]    @relation("LabelTemplateUpdatedBy")
  paperworkRevisions    DriverPaperworkRevision[]
  authSessions          AuthSession[]
  accountCodes          AccountCode[]
}

model AuthSession {
  id                String   @id
  userId            String
  authVersion       Int
  kind              String
  deviceName        String
  createdAt         DateTime @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  reauthenticatedAt DateTime?
  lastUsedAt        DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mcpGrant          McpGrant?

  @@index([userId, revokedAt, expiresAt])
}

model McpClient {
  id            String @id
  name          String
  redirectUris  String[]
  authMethod    String @default("none")
  secretHash    String?
  metadataUrl   String?
  metadataUntil DateTime?
  createdAt     DateTime @default(now())
  authorizations McpAuthorization[]
  grants         McpGrant[]
}

model McpAuthorization {
  id               String @id
  clientId         String
  client           McpClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  redirectUri      String
  resource         String
  state            String?
  scopes           String[]
  challenge        String
  browserSessionId String?
  userId           String?
  authVersion      Int?
  codeHash         String? @unique
  decidedAt        DateTime?
  consumedAt       DateTime?
  createdAt        DateTime @default(now())
  expiresAt        DateTime
  @@index([expiresAt])
}

model McpGrant {
  id                  String @id
  clientId            String
  client              McpClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId              String
  sessionId           String @unique
  session             AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  approvedBySessionId String
  authVersion         Int
  scopes              String[]
  resource            String
  generation          Int @default(0)
  createdAt           DateTime @default(now())
  expiresAt           DateTime
  revokedAt           DateTime?
  tokens              McpToken[]
  operations          McpOperation[]
  artifacts           McpArtifact[]
  @@index([userId, revokedAt])
}

model McpToken {
  id         String @id
  tokenHash  String @unique
  grantId    String
  grant      McpGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  kind       String
  generation Int
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  usedAt     DateTime?
  @@index([grantId])
}

model McpOperation {
  id          String @id @default(cuid())
  grantId     String
  grant       McpGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  operationId String
  action      String
  inputHash   String
  state       String
  result      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([grantId, operationId])
}

model McpArtifact {
  id          String @id
  grantId     String
  grant       McpGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  filename    String
  contentType String
  bytes       Bytes
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  @@index([expiresAt])
}

model AccountCode {
  id          String   @id @default(cuid())
  userId      String
  purpose     String
  tokenHash   String   @unique
  authVersion Int
  operationId String   @unique
  issuedById  String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
}

model AuthRateLimit {
  key         String   @id
  windowStart DateTime
  attempts    Int
}

model AuthAudit {
  id          String   @id @default(cuid())
  action      String
  actorUserId String?
  targetUserId String?
  sessionId   String?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([targetUserId, createdAt])
}

model AuthPolicy {
  id                 String  @id
  legacyLoginEnabled Boolean @default(true)
}

// Append-only published snapshots. Restoring an older template creates a new version.
model DriverPaperworkRevision {
  version         Int      @id
  template        Json
  program         String
  contentHash     String
  operationId     String   @unique
  baseVersion     Int
  createdByUserId String?
  createdAt       DateTime @default(now())
  createdByUser   User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
}

model ApiRelayDefinition {
  id           String   @id
  name         String
  enabled      Boolean  @default(false)
  origins      String[]
  pathPrefix   String
  identityPath String
  subjectPath  String
  operations   Json
  program      String
  revision     Int      @default(1)
  updatedAt    DateTime @updatedAt
}

model ApiRelayRevision {
  id              String   @id @default(cuid())
  relayId         String
  revision        Int
  baseRevision    Int
  operationId     String   @unique
  contentHash     String
  snapshot        Json
  createdByUserId String
  createdAt       DateTime @default(now())

  @@unique([relayId, revision])
}

model LabelPrinter {
  id              String   @id @default(cuid())
  name            String   @unique
  endpoint        String
  contentType     String   @default("text/plain")
  isActive        Boolean  @default(true)
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUser   User?    @relation("LabelPrinterCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser   User?    @relation("LabelPrinterUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([isActive, name])
}

model LabelTemplate {
  id              String            @id @default(cuid())
  name            String
  kind            LabelTemplateKind
  zpl             String
  isActive        Boolean           @default(true)
  isDefault       Boolean           @default(false)
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  createdByUser   User?             @relation("LabelTemplateCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser   User?             @relation("LabelTemplateUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([kind, name])
  @@index([kind, isActive, name])
}

model Pipeline {
  id        String   @id @default(cuid())
  name      String
  steps     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MarsImportBatch {
  id               String            @id @default(cuid())
  filename         String
  uploadedByUserId String?
  uploadedAt       DateTime          @default(now())
  rowCount         Int               @default(0)
  insertedCount    Int               @default(0)
  updatedCount     Int               @default(0)
  skippedCount     Int               @default(0)
  notes            String?
  uploadedByUser   User?             @relation(fields: [uploadedByUserId], references: [id])
  marsUnits        MarsUnit[]
  marsAuditReports MarsAuditReport[]
}

model MarsUnit {
  id                        String           @id @default(cuid())
  requestNumber             String           @unique
  orderNumber               String?
  vendor                    String?
  serialNumber              String?
  modelNumber               String?
  vendorRaNumber            String?
  dateRequested             DateTime?
  requestStatus             String?
  returnStatus              String?
  replacementNeeded         String?
  staged                    Boolean          @default(false)
  localStatus               String           @default("active")
  archivedAt                DateTime?
  archivedReason            String?
  presentInLatestImport     Boolean          @default(true)
  missingFromLatestImportAt DateTime?
  lastImportedAt            DateTime?
  lastScannedAt             DateTime?
  lastAuditSeenAt           DateTime?
  lastKnownImportBatchId    String?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  lastKnownImportBatch      MarsImportBatch? @relation(fields: [lastKnownImportBatchId], references: [id])
  marsEvents                MarsEvent[]
  marsAuditScans            MarsAuditScan[]
}

model MarsEvent {
  id         String   @id @default(cuid())
  marsUnitId String
  type       String
  payload    Json
  userId     String?
  createdAt  DateTime @default(now())
  marsUnit   MarsUnit @relation(fields: [marsUnitId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])
}

model MarsAuditSession {
  id               String            @id @default(cuid())
  startedByUserId  String?
  startedAt        DateTime          @default(now())
  completedAt      DateTime?
  lastAmendedAt    DateTime?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  startedByUser    User?             @relation(fields: [startedByUserId], references: [id])
  marsAuditScans   MarsAuditScan[]
  marsAuditReports MarsAuditReport[]
}

model MarsAuditScan {
  id                 String           @id @default(cuid())
  auditSessionId     String
  scannedValue       String
  marsUnitId         String?
  matched            Boolean          @default(false)
  duplicateInSession Boolean          @default(false)
  manualEntry        Boolean          @default(false)
  userId             String?
  createdAt          DateTime         @default(now())
  auditSession       MarsAuditSession @relation(fields: [auditSessionId], references: [id], onDelete: Cascade)
  marsUnit           MarsUnit?        @relation(fields: [marsUnitId], references: [id])
  user               User?            @relation(fields: [userId], references: [id])
}

model MarsAuditReport {
  id                String           @id @default(cuid())
  auditSessionId    String
  importBatchId     String?
  generatedByUserId String?
  label             String?
  createdAt         DateTime         @default(now())
  summary           Json
  payload           Json
  auditSession      MarsAuditSession @relation(fields: [auditSessionId], references: [id], onDelete: Cascade)
  importBatch       MarsImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  generatedByUser   User?            @relation(fields: [generatedByUserId], references: [id])
}

model ScanListSession {
  id              String         @id @default(cuid())
  localDraftId    String?        @unique
  name            String
  createdByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  closedAt        DateTime?
  archivedAt      DateTime?
  createdByUser   User?          @relation(fields: [createdByUserId], references: [id])
  items           ScanListItem[]

  @@index([archivedAt, updatedAt])
}

model ScanListItem {
  id              String          @id @default(cuid())
  sessionId       String
  scannedValue    String
  scannedByUserId String?
  createdAt       DateTime        @default(now())
  session         ScanListSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  scannedByUser   User?           @relation(fields: [scannedByUserId], references: [id])

  @@index([sessionId, createdAt])
}

// Available choices only. Saved route mappings retain their text when a choice is removed.
model PickWaveStagingLocation {
  name      String   @id
  createdAt DateTime @default(now())
}

model PickWave {
  id              String                 @id @default(cuid())
  name            String
  sourceFilename  String
  createdByUserId String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  archivedAt      DateTime?
  createdByUser   User?                  @relation(fields: [createdByUserId], references: [id])
  items           PickWaveItem[]
  routeMappings   PickWaveRouteMapping[]
  scans           PickWaveScan[]

  @@index([archivedAt, createdAt])
}

model PickWaveItem {
  id             String         @id @default(cuid())
  pickWaveId     String
  rowNumber      Int
  routeNumber    String?
  contact        String?
  orderNumber    String?
  lpn            String?
  serialNumber   String?
  trackingNumber String?
  partNumber     String?
  description    String?
  scannedAt      DateTime?
  createdAt      DateTime       @default(now())
  pickWave       PickWave       @relation(fields: [pickWaveId], references: [id], onDelete: Cascade)
  scans          PickWaveScan[]

  @@unique([pickWaveId, rowNumber])
  @@index([pickWaveId, scannedAt])
  @@index([pickWaveId, lpn])
  @@index([pickWaveId, serialNumber])
  @@index([pickWaveId, trackingNumber])
  @@index([pickWaveId, orderNumber])
}

model PickWaveRouteMapping {
  id              String   @id @default(cuid())
  pickWaveId      String
  routeNumber     String
  stagingLocation String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  pickWave        PickWave @relation(fields: [pickWaveId], references: [id], onDelete: Cascade)

  @@unique([pickWaveId, routeNumber])
  @@index([pickWaveId])
}

model PickWaveScan {
  id              String        @id @default(cuid())
  pickWaveId      String
  itemId          String?
  scannedValue    String
  matched         Boolean       @default(false)
  alreadyScanned  Boolean       @default(false)
  scannedByUserId String?
  createdAt       DateTime      @default(now())
  pickWave        PickWave      @relation(fields: [pickWaveId], references: [id], onDelete: Cascade)
  item            PickWaveItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  scannedByUser   User?         @relation(fields: [scannedByUserId], references: [id])

  @@index([pickWaveId, createdAt])
  @@index([itemId])
}

model RouteRecon {
  id              String           @id @default(cuid())
  name            String
  sourceFilename  String
  routeCount      Int
  createdByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  archivedAt      DateTime?
  createdByUser   User?            @relation(fields: [createdByUserId], references: [id])
  items           RouteReconItem[]

  @@index([archivedAt, createdAt])
}

model RouteReconItem {
  id             String     @id @default(cuid())
  routeReconId   String
  rowNumber      Int
  routeNumber    String?
  contact        String?
  orderNumber    String?
  lpn            String?
  serialNumber   String?
  trackingNumber String?
  partNumber     String?
  description    String?
  createdAt      DateTime   @default(now())
  routeRecon     RouteRecon @relation(fields: [routeReconId], references: [id], onDelete: Cascade)

  @@unique([routeReconId, rowNumber])
  @@index([routeReconId, routeNumber])
}

enum Role {
  admin
  manager
  user
}

enum LabelTemplateKind {
  mars_return
  pick_wave
}


// LPN source records and scan evidence are retained independently of pick-wave deletion.
model InventoryAuditItem {
  id               String   @id @default(cuid())
  lpn              String   @unique
  status           String
  orderNumber      String
  vendor           String
  receivedDate     String
  description      String
  customerName     String
  sourceData       Json
  contentHash      String
  revision         Int      @default(1)
  firstSeenAt      DateTime @default(now())
  sourceChangedAt  DateTime @default(now())
  verifiedAt       DateTime?
  lastScannedAt    DateTime?
  lastScanWaveName  String?
  archivedAt       DateTime?

  @@index([archivedAt, sourceChangedAt, lpn])
  @@index([verifiedAt])
}

model InventoryAuditImport {
  id             String   @id @default(cuid())
  filename       String
  uploadedByName String
  createdAt      DateTime @default(now())
  rowCount       Int
  insertedCount  Int
  changedCount   Int
  unchangedCount Int
  duplicateCount Int
  blankCount     Int

  @@index([createdAt])
}

model InventoryAuditScan {
  id              String   @id @default(cuid())
  sourceScanId    String   @unique
  pickWaveId      String
  pickWaveName    String
  scannedValue    String
  lpn             String?
  scannedByName   String?
  matchedPickWave Boolean
  duplicateInWave Boolean
  scannedAt       DateTime
  exportedAt      DateTime @default(now())

  @@index([lpn, scannedAt])
  @@index([pickWaveId])
}
